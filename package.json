{
  "name": "tutien2d-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "TuTien2D vendor headless control-plane & web dashboard",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @tutien2d/server dev\" \"pnpm --filter @tutien2d/web dev\"",
    "dev:server": "pnpm --filter @tutien2d/server dev",
    "dev:web": "pnpm --filter @tutien2d/web dev",
    "build": "pnpm --filter \"@tutien2d/*\" build",
    "start": "pnpm --filter @tutien2d/server start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
