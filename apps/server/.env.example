# ============================================================================
# TuTien2D server — mẫu cấu hình. Cách dùng:
#   cp apps/server/.env.example apps/server/.env     (rồi sửa các dòng có "SỬA")
# File .env KHÔNG được commit (đã nằm trong .gitignore). Đặt quyền chặt: chmod 600 .env
# Sau khi sửa .env phải khởi động lại:  pm2 restart tutien-server --update-env
# ============================================================================

# ---------- Mạng ----------
# Luôn để loopback; reverse proxy (Nginx/Caddy) nhận cổng 443 và chuyển vào đây.
HOST=127.0.0.1
# Cổng server (API + bản web đã build). Đổi nếu 4000 đã bị chiếm, nhớ sửa reverse proxy trỏ đúng cổng.
PORT=4000

# ---------- Tên miền và proxy ngược (BẮT BUỘC khi chạy sau tên miền) ----------
# SỬA: địa chỉ bạn gõ trên trình duyệt, đúng giao thức và KHÔNG có dấu / cuối.
# Thiếu dòng này thì dashboard bị đẩy ra màn hình đăng nhập liên tục (WebSocket/REST bị từ chối Origin).
PUBLIC_ORIGIN=https://bot.example.com
# Nếu truy cập thêm bằng địa chỉ khác, liệt kê cách nhau dấu phẩy. Không dùng *.
# Mặc định (khi không đặt) chỉ cho localhost/127.0.0.1 cổng 3000 và 4000 (dùng khi chạy trên máy cá nhân).
ALLOWED_ORIGINS=https://bot.example.com

# ---------- Game ----------
# Địa chỉ WebSocket của game. Chỉ đặt khi game đổi địa chỉ; mặc định đã đúng.
# GAME_SERVER_URL=wss://game.tutien2d.online/
# SỬA: số hop reverse proxy THẬT phía trước Node (1..10).
#   Nginx/Caddy một mình = 1; Cloudflare + Nginx = 2; Cloudflare + 2 tầng proxy = 3.
# Đặt thừa số hop thì client giả mạo được IP (ảnh hưởng giới hạn tần suất và nhật ký).
TRUST_PROXY=1

# ---------- Dữ liệu ----------
# Thư mục chứa SQLite và khóa .secret. Mặc định (bỏ trống) là ./data cạnh nơi chạy server.
# Trên VPS nên đặt đường dẫn tuyệt đối ngoài thư mục mã nguồn và sao lưu thường xuyên.
# DATA_DIR=/var/lib/tutien2d
# Khóa mã hóa mật khẩu/proxy đã lưu. Bỏ trống thì server tự sinh và lưu ở DATA_DIR/.secret.
# MẤT KHÓA = KHÔNG GIẢI MÃ ĐƯỢC mật khẩu game và URL proxy đã lưu. Nếu tự đặt: tối thiểu 16 ký tự ngẫu nhiên.
# ENCRYPTION_SECRET=

# ---------- Tài khoản admin (chỉ dùng cho lần khởi động ĐẦU TIÊN) ----------
# SỬA: đặt mật khẩu mạnh trước khi mở ra internet; sau khi vào được dashboard hãy ĐỔI mật khẩu rồi xóa 2 dòng này.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=doi-mat-khau-nay-truoc-khi-chay-lan-dau

# ---------- Sức chứa (chọn theo phần cứng, xem docs/PLAN_ARCHITECTURE_V2.md) ----------
# Trần tổng số bot chạy cùng lúc trên cả máy. 0 = không giới hạn.
# Gợi ý hiện tại (code còn chạy mọi bot trong MỘT tiến trình = một nhân):
#   TV box Cortex-A53 -> 1   |   VPS phổ thông -> 5 đến 7
MAX_TOTAL_RUNNERS=1
# Không cho khởi động bot mới khi RAM trống dưới ngưỡng này (MB).
MIN_FREE_MEM_MB=300
# Chu kỳ vòng lặp mô phỏng mỗi bot (ms), 8..50. 16 = 60 Hz (mặc định, hành vi gốc). 33 = 30 Hz giảm khoảng một nửa CPU
# nhưng làm thô nhịp di chuyển/đánh: CHỈ đổi sau khi thử live một bot, theo dõi hurtCount. Bỏ trống = 16.
# VENDOR_LOOP_INTERVAL_MS=16

# ---------- Proxy cho tài khoản game ----------
# 1 = tài khoản chưa gán proxy thì không cho chạy (khuyên dùng khi có proxy).
# 0 = cho chạy không proxy (chỉ khi bạn chấp nhận dùng IP của máy chủ).
REQUIRE_PROXY=1
# Tự gán proxy ít tải nhất còn chỗ khi tạo tài khoản.
AUTO_ASSIGN_PROXY=1
# 0 = chặn proxy trỏ về địa chỉ nội bộ (localhost/192.168.x/10.x...). Chỉ đặt 1 khi thử proxy cục bộ.
ALLOW_PRIVATE_PROXY=0
# Chu kỳ kiểm tra proxy đang dùng (ms) và thời gian chờ mỗi lần (ms). 8 s có thể thiếu nếu mạng chậm.
PROXY_CHECK_INTERVAL_MS=300000
PROXY_CHECK_TIMEOUT_MS=15000

# ---------- Giới hạn chống lạm dụng ----------
API_RATE_LIMIT_USER_PER_MIN=600
API_RATE_LIMIT_IP_PER_MIN=1200
WS_MAX_CONNECTIONS_PER_USER=10
WS_MAX_CONNECTIONS_TOTAL=500
WS_MAX_MESSAGES_PER_MIN=60

# ---------- Sao lưu ----------
# Số bản sao lưu giữ lại (dùng với scripts/backup.mjs). BACKUP_DIR mặc định là DATA_DIR/backups.
BACKUP_KEEP=14
# BACKUP_DIR=/var/backups/tutien2d

# ---------- KHÔNG đặt trên VPS ----------
# API_TOKEN: đường tương thích cũ chỉ cho loopback; dùng đăng nhập bằng tài khoản thay thế.
# ALLOW_LEGACY_API_TOKEN: giữ tắt.
