PORT=4000
# Mặc định chỉ lắng nghe loopback. Nếu đổi sang 0.0.0.0 thì BẮT BUỘC đặt API_TOKEN (>= 32 ký tự, vd: openssl rand -hex 32).
HOST=127.0.0.1
API_TOKEN=
# Để trống: server tự sinh khóa ngẫu nhiên vào data/.secret. Nếu đặt thì >= 16 ký tự, tự sinh, không dùng giá trị mẫu.
ENCRYPTION_SECRET=
# Danh sách origin dashboard được phép (phân tách bằng dấu phẩy). Mặc định là localhost/127.0.0.1 cổng 3000 và 4000.
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4000,http://127.0.0.1:4000
GAME_SERVER_URL=wss://game.tutien2d.online/
