# Copy to /etc/tutien2d/env and edit. Do not commit the real file.
HOST=127.0.0.1
PORT=4000
DATA_DIR=/var/lib/tutien2d
# Số hop reverse proxy thật phía trước Node (vd Nginx = 1, Cloudflare + Nginx = 2). Đặt sai thì IP client có thể bị giả mạo.
TRUST_PROXY=1
PUBLIC_ORIGIN=https://bot.example.com
ALLOWED_ORIGINS=https://bot.example.com

# Only used for the first boot. Change the password immediately, then remove
# these two variables from the service environment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-first-public-boot

# 0 means no configured runner cap; choose a value after Linux soak testing.
MAX_TOTAL_RUNNERS=0
MIN_FREE_MEM_MB=300
BACKUP_KEEP=14
REQUIRE_PROXY=1
AUTO_ASSIGN_PROXY=1
ALLOW_PRIVATE_PROXY=0
PROXY_CHECK_INTERVAL_MS=300000
PROXY_CHECK_TIMEOUT_MS=8000
API_RATE_LIMIT_USER_PER_MIN=600
API_RATE_LIMIT_IP_PER_MIN=1200
WS_MAX_CONNECTIONS_PER_USER=10
WS_MAX_CONNECTIONS_TOTAL=500
WS_MAX_MESSAGES_PER_MIN=60

# Optional: set this only if backups must live outside DATA_DIR/backups.
# BACKUP_DIR=/var/backups/tutien2d

# Do not set API_TOKEN on the VPS. Use session bearer authentication.
